<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User List</title>
</head>
<body>
    <h1>User List</h1>
    <!-- <ul>
        <% users.forEach(user => { %>
            <li><%= user %></li>
        <% }) %>
    </ul> -->
<ul>
    <% for(let i=0; i<users.length; i++) { %>
        <li><%= users[i] %></li>
    <% } %>
</ul>


<% if(isLoggedIn){  %>
    <h3>Welcome, You are logged in!</h3>
    <% }else{ %>
    <h3>Please log in to see the user list.</h3>
    <% } %>
</body>
</html>