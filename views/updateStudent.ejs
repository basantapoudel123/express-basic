<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Information</title>
</head>
<body>
    <form method="post" action="/ui/update/<%= student._id %>">
        <input type="text" name="name" value="<%= student.name %>" placeholder="Enter your name"><br/><br/>
        <input type="text" name="email" value="<%= student.email %>" placeholder="Enter your email"><br/><br/>
        <input type="number" name="age" value="<%= student.age %>" placeholder="Enter your age"><br/><br/>
        <input type="text" name="department" value="<%= student.department %>" placeholder="Enter your department"><br/><br/>
        <button type="submit">Update Student</button>
    </form>
</body>
</html>